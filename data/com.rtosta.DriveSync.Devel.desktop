[Desktop Entry]
Type=Application
Name=DriveSync
GenericName=Google Drive Synchronization
Comment=Keep Google Drive files available on Linux
Exec=drivesync --open-link %f
Icon=com.rtosta.DriveSync.Devel
Terminal=false
Categories=Network;FileTransfer;Utility;
Keywords=Google;Drive;Cloud;Sync;Files;
StartupNotify=true
X-GNOME-UsesNotifications=true
MimeType=application/vnd.drivesync.link;
